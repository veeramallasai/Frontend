# Ignore Git history & metadata
.git
.git/
.git/**
**/.git/**
.github
.github/
.github/**
**/.github/**

# Ignore Flutter/Dart build artifacts & caches
.dart_tool
.dart_tool/
.dart_tool/**
**/.dart_tool/**
.pub-cache
.pub-cache/
.pub-cache/**
.pub
.pub/
.pub/**
build
build/
build/**
**/build/**
*.dill
*.track.dill

# Ignore IDE configuration
.idea
.idea/
.idea/**
**/.idea/**
.vscode
.vscode/
.vscode/**
**/.vscode/**
*.iml

# Ignore native app platforms
android
android/
android/**
**/android/**
ios
ios/
ios/**
**/ios/**
linux
linux/
linux/**
**/linux/**
macos
macos/
macos/**
**/macos/**
windows
windows/
windows/**
**/windows/**

# Ignore non-web workspace components & secondary apps
backend
backend/
backend/**
**/backend/**
flutter_app
flutter_app/
flutter_app/**
**/flutter_app/**
lib_old
lib_old/
lib_old/**
**/lib_old/**
public
public/
public/**
**/public/**
src
src/
src/**
**/src/**
workflows
workflows/
workflows/**
**/workflows/**
node_modules
node_modules/
node_modules/**
**/node_modules/**

# Ignore heavy binaries, logs & scripts
*.jar
*.war
*.zip
*.tar.gz
*.apk
*.aab
*.log
*.bat
temp_seed.js
copy_images.js
build_frontend.bat
run_frontend.bat
