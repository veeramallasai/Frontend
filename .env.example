# Farm2Home Frontend Environment Variables Template

# Backend API base URL for local development
VITE_API_URL=http://localhost:8082/api/v1
VITE_API_BASE_URL=http://localhost:8082/api/v1

# Local Vite proxy target for /api requests in development
VITE_PROXY_TARGET=http://localhost:8082

# Optional fallback API base URL for product read endpoints
VITE_FALLBACK_API_BASE_URL=http://localhost:8082/api/v1

# Google Maps JavaScript API key (optional for location maps and geocoding)
VITE_GOOGLE_MAPS_API_KEY=
