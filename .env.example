# Farm2Home Frontend Environment Variables Template
# Replace with your deployed backend URL on Render or Railway

# Backend API base URL
VITE_API_BASE_URL=https://your-farmtohome-backend.onrender.com/api/v1
VITE_API_URL=https://your-farmtohome-backend.onrender.com/api/v1

# Optional overrides for catalog and export services (defaults are automatically derived from VITE_API_BASE_URL)
# VITE_CATALOG_API_BASE_URL=https://your-farmtohome-backend.onrender.com/api/v1
# VITE_EXPORT_API_BASE_URL=https://your-farmtohome-backend.onrender.com/api

# Google Maps JavaScript API key (optional for location maps and geocoding)
VITE_GOOGLE_MAPS_API_KEY=
